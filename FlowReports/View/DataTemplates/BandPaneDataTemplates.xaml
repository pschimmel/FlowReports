<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ES.Tools.Controls;assembly=ES.Tools"
                    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
                    xmlns:toolsUI="clr-namespace:ES.Tools.UI;assembly=ES.Tools"
                    xmlns:vm="clr-namespace:FlowReports.ViewModel.Editor">
  <ResourceDictionary.MergedDictionaries>
    <toolsUI:SharedResourceDictionary Source="pack://application:,,,/FlowReports;component/View/Brushes.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <BooleanToVisibilityConverter x:Key="VisibilityConverter" />

  <DataTemplate DataType="{x:Type vm:ReportBandViewModel}">
    <Border dd:DragDrop.DropEventType="Bubbled"
            dd:DragDrop.DropHandler="{Binding}"
            dd:DragDrop.IsDropTarget="True"
            BorderThickness="0,0,0,1">
      <Border.Resources>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Resources>
      <Border.InputBindings>
        <MouseBinding Command="{Binding EditBandDetailsCommand}" MouseAction="LeftDoubleClick" />
        <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
      </Border.InputBindings>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource ReportBand.Background}" />
          <Setter Property="BorderBrush" Value="{StaticResource ReportBand.BorderBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="Background" Value="{StaticResource ReportBand.SelectedBackground}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="{Binding Height}" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl Content="{Binding HeaderBand}" />
        <TextBlock Grid.Row="1" Margin="4,0" Text="{Binding DataSource}" />
        <Border Grid.Row="2"
                Margin="10,0,0,0"
                HorizontalAlignment="Stretch"
                BorderBrush="{StaticResource ReportBand.BorderBrush}"
                BorderThickness="1,1,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Bands.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ItemsControl ItemsSource="{Binding Bands}" />
        </Border>
        <ContentControl Grid.Row="3" Content="{Binding FooterBand}" />
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:HeaderBandViewModel}">
    <Border Height="{Binding Height}" BorderThickness="0,0,0,1">
      <Border.Resources>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Resources>
      <Border.InputBindings>
        <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
        <MouseBinding Command="{Binding EditBandDetailsCommand}" MouseAction="LeftDoubleClick" />
      </Border.InputBindings>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource HeaderBand.Background}" />
          <Setter Property="BorderBrush" Value="{StaticResource ReportBand.BorderBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="Background" Value="{StaticResource HeaderBand.SelectedBackground}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <controls:AutoGrayableImage Width="16"
                                    Height="16"
                                    Margin="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Source="pack://application:,,,/FlowReports;component/View/Images/Repeat_16x.png"
                                    Visibility="{Binding RepeatOnEachPage, Converter={StaticResource VisibilityConverter}}" />
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FooterBandViewModel}">
    <Border BorderThickness="0,0,0,1">
      <Border.Resources>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Resources>
      <Border.InputBindings>
        <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
      </Border.InputBindings>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource HeaderBand.Background}" />
          <Setter Property="BorderBrush" Value="{StaticResource ReportBand.BorderBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="Background" Value="{StaticResource HeaderBand.SelectedBackground}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition Height="{Binding Height}" />
        </Grid.RowDefinitions>
        <Border HorizontalAlignment="Stretch" BorderBrush="{StaticResource ReportBand.BorderBrush}" BorderThickness="0,1,0,0" />
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>