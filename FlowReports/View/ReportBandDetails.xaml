<Window x:Class="FlowReports.View.ReportBandDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ES.Tools.Controls;assembly=ES.Tools"
        xmlns:converters="clr-namespace:ES.Tools.Converters;assembly=ES.Tools"
        xmlns:toolsUI="clr-namespace:ES.Tools.UI;assembly=ES.Tools"
        xmlns:model="clr-namespace:FlowReports.Model.ReportItems;assembly=FlowReports"
        xmlns:properties="clr-namespace:FlowReports.Properties"
        xmlns:editoritems="clr-namespace:FlowReports.ViewModel.Editor"
        Title="{x:Static properties:Resources.Details}"
        Width="700"
        Height="400"
        d:DataContext="{d:DesignInstance Type=editoritems:ReportBandViewModel}"
        mc:Ignorable="d">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <toolsUI:SharedResourceDictionary Source="/FlowReports;component/View/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:NegationConverter x:Key="NegationConverter" />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Style="{StaticResource LabelTextBlockStyle}" Text="{x:Static properties:Resources.DataSource}" />
      <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource EditTextBoxStyle}" Text="{Binding DataSource}" />

      <TextBlock Grid.Row="1"
                 Margin="0,5,0,0"
                 VerticalAlignment="Top"
                 Style="{StaticResource LabelTextBlockStyle}"
                 Text="{x:Static properties:Resources.Filter}" />
      <TextBox Grid.Row="1"
               Grid.Column="1"
               MinHeight="60"
               AcceptsReturn="True"
               Style="{StaticResource EditTextBoxStyle}"
               Text="{Binding FilterExpressionText}"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />

      <TextBlock Grid.Row="2" Style="{StaticResource LabelTextBlockStyle}" Text="{x:Static properties:Resources.FilterExamplesHeader}" />
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5,0,0">
        <TextBlock Text="{x:Static properties:Resources.FilterExample1}" Style="{StaticResource SmallTextBlockStyle}"/>
        <TextBlock Text="{x:Static properties:Resources.FilterExample2}" Style="{StaticResource SmallTextBlockStyle}"/>
        <TextBlock Text="{x:Static properties:Resources.FilterExample3}" Style="{StaticResource SmallTextBlockStyle}"/>
        <TextBlock Text="{x:Static properties:Resources.FilterExample4}" Style="{StaticResource SmallTextBlockStyle}"/>
      </StackPanel>

      <TextBlock Grid.Row="3" Style="{StaticResource LabelTextBlockStyle}" Text="{x:Static properties:Resources.OrderBy}" />
      <Grid Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Orderings}" SelectedItem="{Binding SelectedOrdering, Mode=TwoWay}" MinHeight="60">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBox Text="{Binding Property, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,5,0" />
                <ComboBox SelectedValue="{Binding Direction, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Width="120">
                  <ComboBoxItem Content="{x:Static properties:Resources.Ascending}" Tag="{x:Static model:SortDirection.Ascending}" />
                  <ComboBoxItem Content="{x:Static properties:Resources.Descending}" Tag="{x:Static model:SortDirection.Descending}" />
                </ComboBox>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5,0,0,0">
          <Button ToolTip="{x:Static properties:Resources.AddOrder}" Command="{Binding AddOrderCommand}" Style="{StaticResource ButtonDefault}">
            <controls:AutoGrayableImage Source="pack://application:,,,/FlowReports;component/View/Images/Add_16x.png" />
          </Button>
          <Button ToolTip="{x:Static properties:Resources.RemoveOrder}" Command="{Binding RemoveOrderCommand}" Style="{StaticResource ButtonDefault}">
            <controls:AutoGrayableImage Source="pack://application:,,,/FlowReports;component/View/Images/Remove_16x.png" />
          </Button>
          <Button ToolTip="{x:Static properties:Resources.MoveOrderUp}" Command="{Binding MoveOrderUpCommand}" Style="{StaticResource ButtonDefault}" >
            <controls:AutoGrayableImage Source="pack://application:,,,/FlowReports;component/View/Images/ArrowUp_16x.png" />
          </Button>
          <Button ToolTip="{x:Static properties:Resources.MoveOrderDown}" Command="{Binding MoveOrderDownCommand}" Style="{StaticResource ButtonDefault}" >
            <controls:AutoGrayableImage Source="pack://application:,,,/FlowReports;component/View/Images/ArrowDown_16x.png" />
          </Button>
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="4" Style="{StaticResource LabelTextBlockStyle}" Text="{x:Static properties:Resources.Height}" />
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
        <TextBox Width="150"
                 IsEnabled="{Binding HeightAuto, Converter={StaticResource NegationConverter}}"
                 Style="{StaticResource DoubleTextBoxStyle}"
                 Text="{Binding Height}" />
        <CheckBox Content="{x:Static properties:Resources.Auto}" IsChecked="{Binding HeightAuto}" Style="{StaticResource EditCheckBoxStyle}" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Click="OKButton_Click" Style="{StaticResource OKButton}" />
      <Button Click="CancelButton_Click" Style="{StaticResource CancelButton}" />
    </StackPanel>
  </Grid>
</Window>
