<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>..\Output\bin</BaseOutputPath>
    <Version>0.8.14.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Model\DataSources\**" />
    <Compile Remove="Model\Events\**" />
    <Compile Remove="Model\ReportItems\**" />
    <EmbeddedResource Remove="Model\DataSources\**" />
    <EmbeddedResource Remove="Model\Events\**" />
    <EmbeddedResource Remove="Model\ReportItems\**" />
    <None Remove="Model\DataSources\**" />
    <None Remove="Model\Events\**" />
    <None Remove="Model\ReportItems\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="NUnit" Version="4.6.0" />
    <PackageReference Include="NUnit.ConsoleRunner" Version="3.22.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.13.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowReports\FlowReports.csproj" />
  </ItemGroup>

</Project>
